# ---- required ---------------------------------------------------------------
NODE_ENV=production
# Managed Postgres 14+ with a UTF-8 database (city names are Cyrillic).
DATABASE_URL=postgres://sng:change-me@localhost:5432/sng
# Comma-separated Google emails that are platform owners (approve members, edit FX rates).
OWNER_EMAILS=owner@example.com

# ---- recommended ------------------------------------------------------------
# Set to true when a managed database requires TLS (most do).
DATABASE_SSL=false
# Behind a load balancer / reverse proxy set true so rate limits use the real client IP.
TRUST_PROXY=true
# Web workers per container: a number or "auto" (one per CPU).
WEB_CONCURRENCY=auto
# Connections per worker. Keep WEB_CONCURRENCY x DB_POOL_MAX below your Postgres max_connections.
DB_POOL_MAX=20
# Only needed if the API and web app are served from different origins (comma-separated).
CORS_ORIGINS=
# Flip to true once the browser console shows no CSP reports for a few days.
CSP_ENFORCE=false

# ---- AI: "paste loads" import (Gemini) --------------------------------------
# Create a key at https://aistudio.google.com/apikey (a Google AI Pro chat subscription does not include API
# access; the API has its own free tier + pay-as-you-go). Keep it server-side only - never in the web app.
GEMINI_API_KEY=
# Comma-separated, tried in order (a retired/overloaded model falls through to the next).
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
# Without a key the paste feature still works in BASIC mode (a simple rule-based reader). Set to false to turn it off.
AI_FALLBACK=true
AI_RATE_PER_HOUR=200
AI_MAX_PARALLEL=8

# ---- Telegram bot (bot/) -----------------------------------------------------
# Runs as its own process (`npm run bot`), sharing this DATABASE_URL. See bot/README.md.
# Create a bot with @BotFather on Telegram and paste its token here. The API server (server/) reads
# this too, to verify the signed data a Telegram Mini App sends on launch - see AUTH_SECRET above and
# server/src/routes/telegramAuth.js. Telegram sign-in in the web app is simply off without it.
TELEGRAM_BOT_TOKEN=
# The *public* Firebase Web API key - the same "apiKey" already in web/js/config.js. Letting the
# bot exchange a member's e-mail+password for a session is exactly what the web app's sign-in form
# does; the key does not grant any extra privilege.
FIREBASE_WEB_API_KEY=AIzaSyDryrZCdCuYNZrx8PQe83U4x3YL0Ipz3Hg
# Where the bot sends load-posting requests (the running API, same place DATABASE_URL points at).
API_BASE_URL=http://127.0.0.1:8080
# The address a person's browser can reach, used to build each load's "view on the loadboard" link
# (?load=<id>). Only set this if it differs from API_BASE_URL (e.g. the bot talks to the API over
# an internal address, as on Render - see render.yaml) - otherwise it defaults to API_BASE_URL.
PUBLIC_WEB_URL=
# The Mini App's own public https:// URL (same site as PUBLIC_WEB_URL, unless you host it separately).
# Telegram refuses non-https addresses. Sets the bot's default menu button and makes /app work; leave
# blank to run the bot without a Mini App launcher.
MINIAPP_URL=
# 32 random bytes, base64 - encrypts each linked member's refresh token at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_ENCRYPTION_KEY=
# Language used for messages broadcast to groups (en/ru/uz) - a group mixes people, so there is no
# single "this chat's language" to follow the way DMs follow each person's own /language choice.
BOT_BROADCAST_LANG=uz
# Our own official channel/group, invited in the welcome message, the /postload confirmation, and
# every broadcast message. Optional - leave blank to omit. No leading "@" needed (stripped if given).
BOT_JOIN_CHANNEL=sngOne_yuklar
BOT_JOIN_GROUP=sngOne_yuklarr

# ---- Telegram ingest bot (bot/src/ingestIndex.js) ---------------------------
# A SEPARATE bot + process from the one above: joins big public freight-posting groups (not your
# own broadcast chats) and turns matching messages into loads automatically, via the same AI parser
# the web app's "paste from Telegram" screen uses. See bot/README.md "Ingestion bot" before running
# this - it needs its own @BotFather bot with privacy mode DISABLED, and a dedicated member account
# you create and approve once on the web app.
# A second bot token - create it with @BotFather, then send that bot /setprivacy -> Disable (without
# this it only sees @mentions/commands, not ordinary group messages).
TELEGRAM_INGEST_BOT_TOKEN=
# E-mail + password of a member account you sign up and approve yourself - every auto-imported load
# is posted as this account (its profile phone/telegram/e-mail become the contact shown on loads
# whose source message didn't carry its own - set a real monitored phone/Telegram there).
INGEST_SERVICE_EMAIL=
INGEST_SERVICE_PASSWORD=
# Skip messages shorter than this before spending an AI call.
INGEST_MIN_CHARS=25
# Skip messages with no phone number or @handle at all (most non-load chatter). Set to false only
# if your source groups often omit contact info and you are OK with more AI calls on noise.
INGEST_REQUIRE_CONTACT=true
# How long (hours) the same route + pickup date + contact blocks a repost from becoming a second load.
INGEST_DEDUPE_WINDOW_HOURS=72
# Caps how often this bot calls the AI parser, independent of how busy a source group gets - keep
# this (x60) comfortably under AI_RATE_PER_HOUR above, since the service account shares that budget.
INGEST_AI_MAX_PER_MIN=6
# Comma-separated Telegram user ids allowed to DM this bot /ingeststatus, /pausesource, /resumesource.
# Get your own id from @userinfobot on Telegram.
INGEST_ADMIN_TG_IDS=

# ---- optional tuning (defaults shown) ---------------------------------------
PORT=8080
FIREBASE_PROJECT_ID=sng-pro
LOG_LEVEL=info
AUTO_MIGRATE=true
DB_STATEMENT_TIMEOUT_MS=8000
RATE_LIMIT_PER_MIN=600
WRITE_RATE_LIMIT_PER_MIN=40
MAX_ACTIVE_LOADS_PER_MEMBER=500
MAX_ACTIVE_TRUCKS_PER_MEMBER=200
MAX_POSTS_PER_HOUR=200
# Growth tools (posting and searching stay free): free repost to the Telegram groups once per N hours per load; one TOP
# credit = N hours at the top of matching searches; TOP credits an inviter earns when an invited friend posts a first load.
REPOST_COOLDOWN_HOURS=6
BOOST_HOURS=24
REFERRAL_REWARD_CREDITS=1
# Telegram bot: set on exactly ONE bot process to DM inviters when their friend posts a first load.
# BOT_SEND_REFERRAL_NOTICES=1
ROAD_FACTOR=1.2
COUNT_CACHE_MS=5000
MEMBER_CACHE_MS=10000
# Result pages shared between users for this long (any write clears them within 0.5 s).
SEARCH_CACHE_MS=1500
# Board changes are announced to browsers at most once per window.
EVENT_BATCH_MS=1000
# Requests allowed to wait for a DB connection before new ones are shed with 503 (default: DB_POOL_MAX x 10).
DB_MAX_QUEUE=
