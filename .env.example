# ---- required ---------------------------------------------------------------
NODE_ENV=production
# Managed Postgres 14+ with a UTF-8 database (city names are Cyrillic).
DATABASE_URL=postgres://sng:change-me@localhost:5432/sng
# Comma-separated Google emails that are platform owners (approve members, edit FX rates).
OWNER_EMAILS=owner@example.com

# ---- recommended ------------------------------------------------------------
# Set to true when a managed database requires TLS (most do).
DATABASE_SSL=false
# Behind a load balancer / reverse proxy set true so rate limits use the real client IP.
TRUST_PROXY=true
# Web workers per container: a number or "auto" (one per CPU).
WEB_CONCURRENCY=auto
# Connections per worker. Keep WEB_CONCURRENCY x DB_POOL_MAX below your Postgres max_connections.
DB_POOL_MAX=20
# Only needed if the API and web app are served from different origins (comma-separated).
CORS_ORIGINS=
# Flip to true once the browser console shows no CSP reports for a few days.
CSP_ENFORCE=false

# ---- AI: "paste loads" import (Gemini) --------------------------------------
# Create a key at https://aistudio.google.com/apikey (a Google AI Pro chat subscription does not include API
# access; the API has its own free tier + pay-as-you-go). Keep it server-side only - never in the web app.
GEMINI_API_KEY=
# Comma-separated, tried in order (a retired/overloaded model falls through to the next).
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
# Without a key the paste feature still works in BASIC mode (a simple rule-based reader). Set to false to turn it off.
AI_FALLBACK=true
AI_RATE_PER_HOUR=40
AI_MAX_PARALLEL=8

# ---- Telegram bot (bot/) -----------------------------------------------------
# Runs as its own process (`npm run bot`), sharing this DATABASE_URL. See bot/README.md.
# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=
# The *public* Firebase Web API key - the same "apiKey" already in web/js/config.js. Letting the
# bot exchange a member's e-mail+password for a session is exactly what the web app's sign-in form
# does; the key does not grant any extra privilege.
FIREBASE_WEB_API_KEY=AIzaSyDryrZCdCuYNZrx8PQe83U4x3YL0Ipz3Hg
# Where the bot sends load-posting requests (the running API, same place DATABASE_URL points at).
API_BASE_URL=http://127.0.0.1:8080
# The address a person's browser can reach, used to build each load's "view on the loadboard" link
# (?load=<id>). Only set this if it differs from API_BASE_URL (e.g. the bot talks to the API over
# an internal address, as on Render - see render.yaml) - otherwise it defaults to API_BASE_URL.
PUBLIC_WEB_URL=
# 32 random bytes, base64 - encrypts each linked member's refresh token at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_ENCRYPTION_KEY=
# Language used for messages broadcast to groups (en/ru/uz) - a group mixes people, so there is no
# single "this chat's language" to follow the way DMs follow each person's own /language choice.
BOT_BROADCAST_LANG=en

# ---- optional tuning (defaults shown) ---------------------------------------
PORT=8080
FIREBASE_PROJECT_ID=sng-pro
LOG_LEVEL=info
AUTO_MIGRATE=true
DB_STATEMENT_TIMEOUT_MS=8000
RATE_LIMIT_PER_MIN=600
WRITE_RATE_LIMIT_PER_MIN=40
MAX_ACTIVE_LOADS_PER_MEMBER=500
MAX_ACTIVE_TRUCKS_PER_MEMBER=200
MAX_POSTS_PER_HOUR=200
ROAD_FACTOR=1.2
COUNT_CACHE_MS=5000
MEMBER_CACHE_MS=10000
# Result pages shared between users for this long (any write clears them within 0.5 s).
SEARCH_CACHE_MS=1500
# Board changes are announced to browsers at most once per window.
EVENT_BATCH_MS=1000
# Requests allowed to wait for a DB connection before new ones are shed with 503 (default: DB_POOL_MAX x 10).
DB_MAX_QUEUE=
