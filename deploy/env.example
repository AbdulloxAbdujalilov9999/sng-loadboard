# Copy to ".env" in this folder on the server and fill in:   cp env.example .env && nano .env
# ".env" is never committed to git. Keep a copy somewhere safe (password manager) - you need it to rebuild the server.

# Your site's address WITHOUT https://  (a domain pointed at the server's IP, or the free test name below)
SITE_ADDRESS=2-29-41-94.sslip.io

# Long random password for the database:   openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# Google account email(s) of the platform owner(s), comma-separated
OWNER_EMAILS=

# Secret for phone + 4-digit PIN sign-in. Leave it empty: deploy/update.sh generates a strong one the first time.
AUTH_SECRET=

# AI paste import (https://aistudio.google.com/apikey). Empty = basic offline mode.
GEMINI_API_KEY=
AI_RATE_PER_HOUR=200

# 2 workers fit a 2-vCPU server. Raise together with the server size.
WEB_CONCURRENCY=2

# The Mini App is deployed separately (Vercel, its own repo) and calls this API cross-origin - set
# this to its real URL if it differs from the default guess in compose.yaml. Comma-separated for more
# than one (e.g. a custom domain plus the vercel.app one).
CORS_ORIGINS=

# --- only for the Telegram bot (docker compose --profile bot up -d) ---
# Also used by the api service as a second trusted Mini App signer alongside TELEGRAM_BOT_TOKEN_SNGONE
# below, so a Mini App button opened from this bot (e.g. one sent before the two bots were split) still
# signs someone in instead of a dead-end 401 - set this even if you never run the bot profile itself.
TELEGRAM_BOT_TOKEN=
# openssl rand -base64 32
BOT_ENCRYPTION_KEY=
BOT_BROADCAST_LANG=uz
BOT_JOIN_CHANNEL=sngOne_yuklar
BOT_JOIN_GROUP=sngOne_yuklarr

# --- @sngonebot: a second, permanent bot on this same platform/database (docker compose --profile sngonebot up -d) ---
# The Mini App's only home - a separate deployment (Vercel, its own repo: sng-miniapp-web), not served
# from here. Uses the same BOT_ENCRYPTION_KEY as TELEGRAM_BOT_TOKEN above.
TELEGRAM_BOT_TOKEN_SNGONE=
# Set this if the real Vercel URL differs from compose.yaml's default guess (https://sng-miniapp-web.vercel.app).
MINIAPP_URL=

# --- only while migrating off an old bot token (docker compose --profile bot_old up -d) ---
# Keeps the OLD @BotFather bot running too, so people/groups that only know it don't lose it while
# everyone moves to the new one above. Leave blank normally; remove this line once nobody needs the
# old bot anymore (and run: docker compose rm -sf bot_old).
TELEGRAM_BOT_TOKEN_OLD=
