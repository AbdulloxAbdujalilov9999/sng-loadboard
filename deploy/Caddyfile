# Caddy gets and renews the HTTPS certificate by itself. SITE_ADDRESS comes from .env.
{$SITE_ADDRESS} {
	encode zstd gzip
	# flush_interval -1: live updates (Server-Sent Events) must not be buffered
	reverse_proxy api:8080 {
		flush_interval -1
	}
}

# www.<domain> -> <domain>   (needs an A record for www; harmless otherwise)
www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# Other projects on the same server: add a file such as sites/truckerz.caddy containing
#   truckerz.example.com { reverse_proxy host.docker.internal:3000 }
import /etc/caddy/sites/*.caddy
